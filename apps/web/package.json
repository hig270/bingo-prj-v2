{
  "name": "@bingo/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run /^dev:/",
    "dev:vite": "vite",
    "dev:css": "hcm 'src/**/*.module.scss' --watch",
    "css-types": "hcm 'src/**/*.module.scss'",
    "build": "pnpm run css-types && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm run css-types && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bingo/game": "workspace:*",
    "@bingo/protocol": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "catalog:",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@cloudflare/vite-plugin": "^1.69.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-css-modules": "^5.0.2",
    "postcss": "^8.5.32",
    "sass": "^1.108.2",
    "typescript": "catalog:",
    "vite": "^8.3.8",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
